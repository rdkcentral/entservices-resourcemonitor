precondition = ["Platform"]
callsign = "org.rdk.ResourceMonitor"
autostart = "@PLUGIN_RESOURCEMONITOR_AUTOSTART@"
startuporder = "@PLUGIN_RESOURCEMONITOR_STARTUPORDER@"

configuration = JSON()
rootobject = JSON()

rootobject.add("mode", "@PLUGIN_RESOURCEMONITOR_MODE@")
rootobject.add("locator", "lib@PLUGIN_IMPLEMENTATION@.so")

# Add plugin-specific configuration parameters
rootobject.add("psi_checking_enabled", True)
rootobject.add("zram_checking_enabled", True)
rootobject.add("psi_path", "/proc/pressure/memory")
rootobject.add("psi_metrics", "full_avg60")
rootobject.add("psi_excess_duration", 50000)
rootobject.add("psi_post_action_delay", 1000000)
rootobject.add("flash_space_for_hibernated_apps_size", 300)
rootobject.add("flash_space_for_hibernated_apps_mount_point", "/mnt/media/apps/hibernated_apps")   
rootobject.add("polling_interval", 5000)
rootobject.add("low_memory_warnings_enabled", True)
rootobject.add("warning_threshold_min_mem", 300000)
rootobject.add("warning_threshold_max_swap_percentage", 40)
rootobject.add("warning_threshold_max_psi", 1)
rootobject.add("soft_threshold_delta_percentage", 10)
rootobject.add("hard_threshold_delta_percentage", 20)
rootobject.add("min_post_warning_delay", 60)

configuration.add("root", rootobject)
